{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lunchmap: start web server",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "0.0.0.0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Serving HTTP on"
                }
            }
        }
    ]
}
